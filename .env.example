# Database (Supabase Postgres)
# Append ?connect_timeout=30 (or higher) if your network has high latency to
# the Supabase region — Prisma's default connect timeout can be too short.
# DATABASE_URL: Supabase pooled connection string (used by the app at runtime)
DATABASE_URL="your-supabase-pooled-connection-string"
# DIRECT_URL: Supabase direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="your-supabase-direct-connection-string"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Gemini AI — primary provider (server-side only, never exposed to client)
GEMINI_API_KEY=""

# OpenRouter AI — fallback provider (server-side only, never exposed to client)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# Maps (server-side proxy; configurable provider)
MAP_PROVIDER="mapbox"
MAPBOX_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# Weather (Open-Meteo requires no key, included for completeness)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# Air Quality (OpenAQ)
OPENAQ_API_KEY=""
OPENAQ_BASE_URL="https://api.openaq.org/v3"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
